<!-- Chronos MCP Node: Version Switcher -->
<style>
    #chronos-orb {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        font-family: 'Outfit', system-ui, sans-serif
    }

    #chronos-btn {
        position: relative;
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 0.75rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 4px 20px rgba(99, 102, 241, 0.2);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        transition: transform 0.2s
    }

    #chronos-btn:hover {
        transform: scale(1.05)
    }

    #chronos-btn:active {
        transform: scale(0.95)
    }

    #chronos-spinner {
        position: absolute;
        inset: -50%;
        background: conic-gradient(from 0deg, transparent 0 340deg, #a855f7 360deg);
        opacity: 0.5;
        animation: chronos-spin 8s linear infinite
    }

    @keyframes chronos-spin {
        to {
            transform: rotate(360deg)
        }
    }

    #chronos-btn-inner {
        position: absolute;
        inset: 2px;
        background: #0f172a;
        border-radius: 0.5rem;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center
    }

    #chronos-btn-inner svg {
        width: 1.5rem;
        height: 1.5rem;
        color: #cbd5e1;
        transition: color 0.3s
    }

    #chronos-btn:hover #chronos-btn-inner svg {
        color: #818cf8
    }

    #chronos-btn.active #chronos-btn-inner svg {
        color: #d946ef
    }

    #chronos-panel {
        display: none;
        margin-bottom: 1rem;
        background: rgba(15, 23, 42, 0.92);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1rem;
        box-shadow: 0 8px 40px rgba(168, 85, 247, 0.2);
        overflow: hidden;
        width: 20rem;
        animation: chronos-in 0.25s ease-out
    }

    #chronos-panel.open {
        display: block
    }

    @keyframes chronos-in {
        from {
            opacity: 0;
            transform: translateY(12px) scale(0.95)
        }

        to {
            opacity: 1;
            transform: none
        }
    }

    .chronos-header {
        padding: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        background: rgba(0, 0, 0, 0.4)
    }

    .chronos-header h4 {
        color: #fff;
        font-family: monospace;
        font-size: 0.85rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0
    }

    .chronos-header .pulse-dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: #4ade80;
        animation: chronos-pulse 2s infinite
    }

    @keyframes chronos-pulse {

        0%,
        100% {
            opacity: 1
        }

        50% {
            opacity: 0.4
        }
    }

    .chronos-header p {
        color: #64748b;
        font-size: 0.7rem;
        font-family: monospace;
        margin: 0.25rem 0 0
    }

    .chronos-list {
        padding: 0.5rem;
        position: relative
    }

    .chronos-list::before {
        content: '';
        position: absolute;
        left: 1.5rem;
        top: 1rem;
        bottom: 1rem;
        width: 1px;
        background: rgba(255, 255, 255, 0.07)
    }

    .chronos-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 0.75rem;
        border-radius: 0.75rem;
        border: none;
        background: none;
        width: 100%;
        cursor: pointer;
        text-align: left;
        transition: background 0.2s;
        position: relative
    }

    .chronos-item:hover {
        background: rgba(255, 255, 255, 0.06)
    }

    .chronos-item.current {
        background: rgba(255, 255, 255, 0.04);
        cursor: default
    }

    .chronos-icon {
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: #1e293b;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        position: relative;
        z-index: 2
    }

    .chronos-item.current .chronos-icon {
        background: rgba(99, 102, 241, 0.15);
        border-color: rgba(99, 102, 241, 0.4)
    }

    .chronos-item:hover .chronos-icon {
        border-color: rgba(255, 255, 255, 0.25)
    }

    .chronos-icon svg {
        width: 1rem;
        height: 1rem
    }

    .chronos-label h5 {
        margin: 0;
        font-size: 0.9rem;
        font-weight: 500;
        color: #cbd5e1;
        transition: color 0.2s
    }

    .chronos-item:hover .chronos-label h5 {
        color: #fff
    }

    .chronos-item.current .chronos-label h5 {
        color: #fff
    }

    .chronos-active-badge {
        display: inline-block;
        margin-left: 0.5rem;
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        background: rgba(217, 70, 239, 0.15);
        color: #f0abfc;
        padding: 0.1rem 0.5rem;
        border-radius: 9999px;
        border: 1px solid rgba(217, 70, 239, 0.2);
        vertical-align: middle
    }

    .chronos-label p {
        margin: 0.125rem 0 0;
        font-size: 0.7rem;
        color: #64748b;
        font-family: monospace
    }

    /* Terminal Overlay */
    #chronos-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 10000;
        background: #020617;
        align-items: center;
        justify-content: center;
        padding: 2rem
    }

    #chronos-overlay.active {
        display: flex
    }

    #chronos-overlay .scanlines {
        position: absolute;
        inset: 0;
        background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
        background-size: 100% 4px, 3px 100%;
        pointer-events: none;
        z-index: 10
    }

    #chronos-terminal {
        max-width: 48rem;
        width: 100%;
        border: 1px solid rgba(34, 197, 94, 0.3);
        background: rgba(0, 0, 0, 0.8);
        border-radius: 0.5rem;
        padding: 1.5rem;
        font-family: monospace;
        color: #4ade80;
        position: relative;
        z-index: 20;
        box-shadow: 0 0 30px rgba(34, 197, 94, 0.15)
    }

    .chronos-term-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid rgba(34, 197, 94, 0.3);
        padding-bottom: 1rem
    }

    .chronos-term-header svg {
        width: 1.25rem;
        height: 1.25rem;
        color: #4ade80
    }

    .chronos-term-header span {
        font-size: 0.85rem;
        letter-spacing: 0.15em
    }

    #chronos-logs {
        min-height: 18rem
    }

    .chronos-log-line {
        display: flex;
        margin-bottom: 0.75rem;
        opacity: 0;
        animation: chronos-fade 0.3s forwards
    }

    @keyframes chronos-fade {
        to {
            opacity: 1
        }
    }

    .chronos-log-ts {
        color: #475569;
        margin-right: 1rem;
        white-space: nowrap
    }

    .chronos-log-msg {
        color: #4ade80
    }

    .chronos-log-msg.success {
        color: #d946ef
    }

    #chronos-cursor {
        width: 0.75rem;
        height: 1.25rem;
        background: #4ade80;
        display: inline-block;
        margin-top: 1rem;
        animation: chronos-blink 0.8s step-end infinite
    }

    @keyframes chronos-blink {
        50% {
            opacity: 0
        }
    }
</style>

<div id="chronos-orb">
    <div id="chronos-panel">
        <div class="chronos-header">
            <h4><span class="pulse-dot"></span> Chronos Node</h4>
            <p>MCP Connection: Active // 12+ Years Total Experience</p>
        </div>
        <div class="chronos-list" id="chronos-versions"></div>
    </div>
    <button id="chronos-btn" onclick="toggleChronos()" aria-label="Version Switcher">
        <div id="chronos-spinner"></div>
        <div id="chronos-btn-inner">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z">
                </path>
            </svg>
        </div>
    </button>
</div>

<div id="chronos-overlay">
    <div class="scanlines"></div>
    <div id="chronos-terminal">
        <div class="chronos-term-header">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span>MCP_KERNEL_v4.2.0</span>
        </div>
        <div id="chronos-logs"></div>
        <div id="chronos-cursor"></div>
    </div>
</div>

<script>
    (function () {
        var currentPath = window.location.pathname;
        var versions = [
            { id: 'v4', title: 'The AI Orchestrator', subtitle: 'Leading Current Logic (2026-Present)', url: '/v4/landingPage', container: '0xNEXT_15_CORE', color: '#d946ef', current: false },
            { id: 'v3', title: 'Full-Stack Integration', subtitle: 'Scaling Production (2020-2026)', url: '/v3/landingPage', container: '0xEXPRESS_EJS', color: '#818cf8', current: false },
            { id: 'v2', title: 'The Impact Pivot', subtitle: 'First Growth Phase (2017-2019)', url: '/v2/landingPage', container: '0xHEROKU_LEGACY', color: '#2dd4bf', current: false },
            { id: 'v1', title: 'The Creative Origin', subtitle: 'Academic Genesis (2009-2016)', url: '/v1/landingPage', container: '0xSTATIC_ASSETS', color: 'rgba(255,255,255,0.4)', current: false }
        ];

        // Determine which version is current based on URL
        versions.forEach(function (v) {
            if (currentPath === v.url || (v.url === '/' && (currentPath === '/' || currentPath === '/david-smith'))) v.current = true;
        });

        var list = document.getElementById('chronos-versions');
        versions.forEach(function (v) {
            var btn = document.createElement('button');
            btn.className = 'chronos-item' + (v.current ? ' current' : '');
            btn.innerHTML =
                '<div class="chronos-icon"><svg fill="none" stroke="' + v.color + '" viewBox="0 0 24 24" style="width:1rem;height:1rem"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path></svg></div>' +
                '<div class="chronos-label"><h5>' + v.title + (v.current ? '<span class="chronos-active-badge">Active</span>' : '') + '</h5><p>' + v.id + ' // ' + v.subtitle + '</p></div>';
            if (!v.current) {
                btn.onclick = function () { runChronosTransition(v.title, v.container, v.url); };
            }
            list.appendChild(btn);
        });

        window.toggleChronos = function () {
            var panel = document.getElementById('chronos-panel');
            var btn = document.getElementById('chronos-btn');
            panel.classList.toggle('open');
            btn.classList.toggle('active');
        };

        window.runChronosTransition = function (name, container, url) {
            document.getElementById('chronos-panel').classList.remove('open');
            document.getElementById('chronos-btn').classList.remove('active');
            var overlay = document.getElementById('chronos-overlay');
            var logs = document.getElementById('chronos-logs');
            logs.innerHTML = '';
            overlay.classList.add('active');

            var sequence = [
                '[SYSTEM]: Intercepting temporal routing...',
                '[SYSTEM]: Querying MCP State = "ACTIVE"',
                '[MCP]: Re-initializing persona -> ' + name,
                '[MCP]: Locating legacy container registry...',
                '[SYS_LOG]: Container [' + container + '] found. Waking instance...',
                '[TELEMETRY]: Establishing Neural Link... SUCCESS.',
                '[SYSTEM]: Transferring viewport. Stand by...'
            ];

            var step = 0;
            var interval = setInterval(function () {
                if (step < sequence.length) {
                    var line = document.createElement('div');
                    line.className = 'chronos-log-line';
                    var ts = new Date().toISOString().split('T')[1].slice(0, 11);
                    var isSuccess = sequence[step].indexOf('SUCCESS') !== -1;
                    line.innerHTML = '<span class="chronos-log-ts">' + ts + '</span><span class="chronos-log-msg' + (isSuccess ? ' success' : '') + '">' + sequence[step] + '</span>';
                    logs.appendChild(line);
                    step++;
                } else {
                    clearInterval(interval);
                    setTimeout(function () { window.location.href = url; }, 500);
                }
            }, 400);
        };
    })();
</script>