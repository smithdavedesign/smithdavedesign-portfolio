    document.addEventListener('DOMContentLoaded', function () {
        const phrases = [
            "End-to-end solutions with UX focus.",
            "Scalable cloud-based applications.",
            "Native & cross-platform mobile apps.",
            "Interactive user interfaces.",
            "RESTful APIs",
            "Insights from data for decisions.",
            "Java applications.",
            "Embedded systems.", "Dynamic web applications."];
        const textElement = document.getElementById('animatedText');
        let currentPhraseIndex = 0;

        textElement.addEventListener('animationiteration', function () {
            let newPhrase = phrases[currentPhraseIndex];
            textElement.innerText = newPhrase;
            currentPhraseIndex = (currentPhraseIndex + 1) % phrases.length;
        });
    });
