<style>
  :root {
    --font-sans: 'Inter', system-ui, sans-serif;
    --color-text-primary: #0F172A;
    --color-text-secondary: #475569;
    --color-text-tertiary: #94A3B8;
    --color-background: #FFFFFF;
    --color-background-secondary: #F8FAFC;
    --color-background-tertiary: #F1F5F9;
    --color-border-tertiary: #E2E8F0;
    --color-border-secondary: #CBD5E1;
    --teal: #1D9E75;
    --purple: #534AB7;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: var(--font-sans); color: var(--color-text-primary); background: var(--color-background); }

  .page { max-width: 860px; margin: 0 auto; padding: 40px 32px 60px; }

  /* Print bar */
  .print-bar { display: flex; justify-content: flex-end; margin-bottom: 24px; gap: 10px; }
  .btn { font-family: 'DM Mono', monospace; font-size: 11px; padding: 6px 14px; border-radius: 5px; border: 1px solid var(--color-border-secondary); cursor: pointer; background: var(--color-background-secondary); color: var(--color-text-secondary); text-decoration: none; transition: background 0.15s; }
  .btn:hover { background: var(--color-background-tertiary); }
  .btn.primary { background: var(--teal); color: #fff; border-color: var(--teal); }
  .btn.primary:hover { background: #168a64; }

  /* Hero */
  .hero { border-bottom: 2px solid var(--color-border-tertiary); padding-bottom: 22px; margin-bottom: 28px; }
  .hero-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .name { font-family: 'Playfair Display', serif; font-size: 34px; font-weight: 700; letter-spacing: -0.5px; line-height: 1.1; color: var(--color-text-primary); }
  .title-badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .badge { font-family: 'DM Mono', monospace; font-size: 10px; padding: 3px 10px; border-radius: 4px; border: 1px solid; letter-spacing: 0.03em; }
  .badge.eng { background: #E1F5EE; color: #085041; border-color: #5DCAA5; }
  .badge.mgr { background: #EEEDFE; color: #3C3489; border-color: #AFA9EC; }
  .badge.ai  { background: #FAEEDA; color: #633806; border-color: #EF9F27; }
  .contact-block { text-align: right; font-size: 12px; color: var(--color-text-secondary); line-height: 2.1; }
  .contact-block a { color: var(--teal); text-decoration: none; }
  .contact-block a:hover { text-decoration: underline; }
  .tagline { font-size: 14px; color: var(--color-text-secondary); line-height: 1.75; margin-top: 14px; border-left: 3px solid var(--purple); padding-left: 14px; }

  /* Section chrome */
  .section { margin-bottom: 32px; }
  .section-label { font-family: 'DM Mono', monospace; font-size: 9px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--teal); margin-bottom: 14px; display: flex; align-items: center; gap: 10px; }
  .section-label::after { content: ''; flex: 1; height: 1px; background: var(--color-border-tertiary); }

  /* AI layer stack */
  .layer-stack { display: flex; flex-direction: column; gap: 7px; }
  .layer { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 8px; border: 1px solid var(--color-border-tertiary); }
  .layer-icon { font-size: 15px; width: 26px; text-align: center; flex-shrink: 0; }
  .layer-name { font-family: 'DM Mono', monospace; font-size: 12px; font-weight: 500; color: var(--color-text-primary); min-width: 180px; }
  .layer-desc { font-size: 12px; color: var(--color-text-secondary); line-height: 1.5; }
  .layer.you { background: #E1F5EE; border-color: #5DCAA5; }
  .layer.you .layer-name { color: #085041; }
  .layer.ai-layer { background: var(--color-background-secondary); border-style: dashed; }

  /* Experience */
  .exp-list { display: flex; flex-direction: column; gap: 24px; }
  .exp-item { display: grid; grid-template-columns: 130px 1fr; gap: 16px; }
  .exp-dates { font-family: 'DM Mono', monospace; font-size: 10px; color: var(--color-text-tertiary); padding-top: 3px; letter-spacing: 0.05em; }
  .exp-role { font-size: 14px; font-weight: 600; color: var(--color-text-primary); }
  .exp-company { font-size: 13px; color: var(--teal); font-weight: 500; margin-top: 2px; }
  .exp-company a { color: var(--teal); text-decoration: none; }
  .exp-company a:hover { text-decoration: underline; }
  .exp-desc { font-size: 12.5px; color: var(--color-text-secondary); line-height: 1.7; margin-top: 7px; }
  .exp-bullets { margin-top: 8px; padding-left: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }
  .exp-bullets li { font-size: 12px; color: var(--color-text-secondary); line-height: 1.6; padding-left: 16px; position: relative; }
  .exp-bullets li::before { content: '▸'; position: absolute; left: 0; color: var(--teal); font-size: 10px; top: 3px; }
  .exp-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 10px; }
  .exp-tag { font-family: 'DM Mono', monospace; font-size: 10px; padding: 2px 8px; border-radius: 99px; border: 1px solid var(--color-border-tertiary); color: var(--color-text-tertiary); background: var(--color-background-secondary); }

  /* Projects grid */
  .projects-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .proj-card { border: 1px solid var(--color-border-tertiary); border-radius: 10px; padding: 14px 16px; background: var(--color-background-secondary); transition: border-color 0.15s; }
  .proj-card:hover { border-color: var(--color-border-secondary); }
  .proj-header { display: flex; align-items: flex-start; gap: 10px; }
  .proj-icon { width: 28px; height: 28px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; }
  .p1 { background: #E1F5EE; } .p2 { background: #FAEEDA; } .p3 { background: #EEEDFE; }
  .p4 { background: #FAECE7; } .p5 { background: #E6F1FB; } .p6 { background: #EAF3DE; }
  .proj-name { font-size: 13px; font-weight: 600; }
  .proj-name a { color: var(--color-text-primary); text-decoration: none; }
  .proj-name a:hover { color: var(--teal); }
  .proj-meta { font-family: 'DM Mono', monospace; font-size: 10px; color: var(--teal); margin-top: 2px; }
  .proj-desc { font-size: 11.5px; color: var(--color-text-secondary); line-height: 1.6; margin-top: 8px; }
  .proj-links { display: flex; gap: 10px; margin-top: 9px; }
  .proj-link { font-family: 'DM Mono', monospace; font-size: 10px; color: var(--color-text-tertiary); text-decoration: none; }
  .proj-link:hover { color: var(--teal); }
  .proj-link.live { color: var(--teal); font-weight: 500; }

  /* Skills */
  .skills-block { display: flex; flex-direction: column; gap: 12px; }
  .skills-row-label { font-family: 'DM Mono', monospace; font-size: 9px; color: var(--color-text-tertiary); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 6px; }
  .skills-grid { display: flex; flex-wrap: wrap; gap: 6px; }
  .pill { font-size: 11px; padding: 3px 10px; border-radius: 99px; border: 1px solid var(--color-border-tertiary); color: var(--color-text-secondary); background: var(--color-background-secondary); }
  .pill.ai   { background: #E1F5EE; color: #085041; border-color: #5DCAA5; }
  .pill.lead { background: #EEEDFE; color: #3C3489; border-color: #AFA9EC; }
  .pill.infra { background: #E6F1FB; color: #0C447C; border-color: #85B7EB; }

  /* Education */
  .edu-item { display: grid; grid-template-columns: 130px 1fr; gap: 16px; }
  .edu-degree { font-size: 14px; font-weight: 600; color: var(--color-text-primary); }
  .edu-school { font-size: 13px; color: var(--teal); margin-top: 2px; }
  .edu-school a { color: var(--teal); text-decoration: none; }
  .edu-detail { font-size: 12px; color: var(--color-text-secondary); margin-top: 4px; }

  /* Toast */
  .toast { position: fixed; bottom: 20px; right: 20px; background: var(--teal); color: #fff; font-size: 12px; padding: 8px 14px; border-radius: 6px; opacity: 0; transition: opacity 0.3s; pointer-events: none; z-index: 99; font-family: 'DM Mono', monospace; }
  .toast.show { opacity: 1; }

  @media print {
    .print-bar { display: none; }
    .page { padding: 18px 22px; }
    .section { margin-bottom: 20px; }
    .toast { display: none; }
  }
  @media (max-width: 620px) {
    .projects-grid { grid-template-columns: 1fr; }
    .exp-item, .edu-item { grid-template-columns: 1fr; gap: 2px; }
    .hero-top { flex-direction: column; }
    .contact-block { text-align: left; }
  }
</style>

