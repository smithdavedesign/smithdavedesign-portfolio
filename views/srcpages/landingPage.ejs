      .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .reveal.active {
        opacity: 1 !important;
        transform: translateY(0) !important;
      }

      .filter-btn {
        @apply px-8 py-3 rounded-full text-[10px] font-bold uppercase tracking-widest bg-white border border-[#4b2c20]/5 text-gray-300 transition-all hover:text-[#1e836c] hover:border-[#1e836c]/20 hover:scale-105;
      }

      .filter-btn.active {
        @apply bg-[#1e836c] text-white border-[#1e836c] shadow-xl shadow-[#1e836c]/20;
      }

      .project-card {
        @apply bg-white rounded-[40px] overflow-hidden border border-gray-50 shadow-sm transition-all duration-700;
      }

      .hover-tilt:hover {
        transform: perspective(1000px) rotateX(1deg) rotateY(1deg) translateY(-10px);
      }

      .font-serif-elegant {
        font-family: 'Fraunces', serif;
      }
    </style>

    <script>
      // Simple Reveal Logic
      const revealOnScroll = () => {
        const reveals = document.querySelectorAll('.reveal');
        reveals.forEach(el => {
          const windowHeight = window.innerHeight;
          const revealTop = el.getBoundingClientRect().top;
          const revealPoint = 100;
          if (revealTop < windowHeight - revealPoint) {
            el.classList.add('active');
          }
        });
      };

      window.addEventListener('scroll', revealOnScroll);
      document.addEventListener('DOMContentLoaded', revealOnScroll);

      function filterProjects(category) {
        $('.filter-btn').removeClass('active');
        $(event.target).addClass('active');

        const projects = $('.project-card');

        if (category === 'All') {
          projects.removeClass('hidden').css('opacity', '0').each(function () {
            const self = $(this);
            setTimeout(() => self.css('opacity', '1'), 50);
          });
        } else {
          projects.addClass('hidden');
          const target = projects.filter('.' + category);
          target.removeClass('hidden').css('opacity', '0').each(function () {
            const self = $(this);
            setTimeout(() => self.css('opacity', '1'), 50);
          });
        }

        // Re-trigger reveal logic for visible elements if needed
        revealOnScroll();
      }

      // Hero "Spotlight" Mask Reveal Logic
      const hero = document.getElementById('hero');
      const mask = document.getElementById('hero-mask');

      // Initial state: Blurred screen (no hole)
      mask.style.webkitMaskImage = "radial-gradient(circle at 50% 50%, transparent 0%, black 0%)";

      hero?.addEventListener('mousemove', (e) => {
        const rect = hero.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;

        // Reveal clear image in a 200px (approx 15%) circle
        const maskValue = `radial-gradient(circle 200px at ${x}% ${y}%, transparent 95%, black 100%)`;
        mask.style.webkitMaskImage = maskValue;
        mask.style.maskImage = maskValue;

        // Ripple/Pop effect on content if cursor is near center
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const dist = Math.hypot(e.clientX - (rect.left + centerX), e.clientY - (rect.top + centerY));

        const content = document.querySelector('.ripple-content');
        if (content) { // Ensure content element exists
          if (dist < 250) {
            const intensity = 1 - (dist / 250);
            content.style.transform = `scale(${1 + (intensity * 0.05)}) translateY(${intensity * -10}px)`;
            content.style.filter = `brightness(${1 + (intensity * 0.2)})`;
          } else {
            content.style.transform = `scale(1) translateY(0)`;
            content.style.filter = `brightness(1)`;
          }
        }
      });

      hero?.addEventListener('mouseleave', () => {
        // Return to full blur screen
        const resetValue = "radial-gradient(circle at 50% 50%, transparent 0%, black 0%)";
        mask.style.webkitMaskImage = resetValue;
        mask.style.maskImage = resetValue; // Added this line for consistency

        // Reset content style on mouse leave
        const content = document.querySelector('.ripple-content');
        if (content) {
          content.style.transform = `scale(1) translateY(0)`;
          content.style.filter = `brightness(1)`;
        }
      });

      function openEmail() { window.location.href = 'mailto:smithdavedesign@gmail.com'; }

      // Improved Smooth Scroll
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            window.scrollTo({
              top: target.offsetTop - 80,
              behavior: 'smooth'
            });
          }
        });
      });
    </script>

