    <script>
       $(function(){

      var _top = $(window).scrollTop();
      var _direction;
      $(window).scroll(function(){
      var _cur_top = $(window).scrollTop();

      var mq = window.matchMedia( "(min-width: 992x)" );
      var width = Math.max(window.screen.width, window.innerWidth);

      if (width > 992) {//check the screen size
      var navB = document.getElementById("home-top");
      if(_top < _cur_top)
        {
            _direction = 'down';
           navB.style.top = "-200px";
           navB.style.borderBottom = "solid 0px #7d4627";

        }
        else
        {
            _direction = 'up';
            navB.style.top = "0";
            navB.style.borderBottom = "solid 1px #7d4627";
            navB.style.backgroundColor = "#c5ded7";
            $(navB).removeClass('bg-transparent')
                  

        }
        _top = _cur_top;
      } else {
      }

     
    });
});

