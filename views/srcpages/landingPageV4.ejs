<script>
    function handleV4Chat(e) {
        e.preventDefault();
        var input = document.getElementById('v4-chat-input');
        var msgs = document.getElementById('v4-chat-messages');
        if (!input.value.trim()) return false;

        // User message
        var userDiv = document.createElement('div');
        userDiv.className = 'flex justify-end';
        userDiv.innerHTML = '<div class="text-xs p-3 rounded-2xl max-w-[85%] bg-blue-600/40 text-blue-100 rounded-tr-sm">' + input.value + '</div>';
        msgs.appendChild(userDiv);

        var question = input.value;
        input.value = '';

        // Bot response
        setTimeout(function () {
            var botDiv = document.createElement('div');
            botDiv.className = 'flex justify-start';
            botDiv.innerHTML = '<div class="text-xs p-3 rounded-2xl max-w-[85%] bg-white/5 text-zinc-300 rounded-tl-sm border border-white/5">Dave specializes in orchestrating LLM agents to deliver measurable ROI. He has led MCP Training series, Copilot analytics dashboards, and AI code review tooling.</div>';
            msgs.appendChild(botDiv);
            msgs.scrollTop = msgs.scrollHeight;
        }, 800);

        return false;
    }
</script>