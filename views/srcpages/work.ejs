<%- include('../partials/Header') %>

  <main class="pt-32 pb-24">
    <!-- Hero Section -->
    <div class="max-w-7xl mx-auto px-6 mb-20 text-center">
      <span class="text-sm font-bold tracking-[0.4em] uppercase text-[#1e836c] mb-6 block">The Impact Pivot</span>
      <h1 class="text-5xl md:text-7xl font-serif-elegant font-bold text-[#4b2c20] mb-8 leading-tight">Past Projects &
        <br />Creative Solutions</h1>
      <div class="w-32 h-1 bg-[#1e836c] mx-auto rounded-full opacity-30"></div>
    </div>

    <!-- Filter Navigation -->
    <div class="max-w-7xl mx-auto px-6 mb-16">
      <div class="flex flex-wrap justify-center gap-4" id="myBtnContainer">
        <button class="filter-btn active" onclick="filterSelection('All')">All Projects</button>
        <button class="filter-btn" onclick="filterSelection('Desktop')">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
            </path>
          </svg>
          Desktop
        </button>
        <button class="filter-btn" onclick="filterSelection('Web')">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9">
            </path>
          </svg>
          Web
        </button>
        <button class="filter-btn" onclick="filterSelection('Mobile')">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
          </svg>
          Mobile
        </button>
      </div>
    </div>

    <!-- Project Gallery -->
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10" id="projectGrid">

        <!-- CWolf-Whisper -->
        <div class="project-card Mobile">
          <div class="overflow-hidden bg-[#e8e4db]">
            <img src="/cwolf-wisper-sonoma-state.png" class="w-full h-64 object-cover project-img" alt="CWolf-Whisper">
          </div>
          <div class="p-8">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-xl font-bold">CWolf-Whisper</h3>
              <span
                class="text-xs font-bold uppercase tracking-widest text-[#1e836c] bg-[#e6f4f1] px-2 py-1 rounded">Mobile</span>
            </div>
            <p
              class="text-sm font-medium text-gray-500 mb-6 font-serif-elegant italic border-l-2 border-[#1e836c]/20 pl-4">
              iOS - Swift</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">Social mobile interactive app. Instant chat, forums,
              and real-time student engagement.</p>
            <div class="pt-6 border-t border-gray-100 flex justify-between items-center">
              <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Feb 2017</span>
              <a href="https://github.com/slixxz/CWolfWhisper"
                class="text-[#1e836c] hover:underline text-xs font-bold uppercase tracking-widest">Source →</a>
            </div>
          </div>
        </div>

        <!-- Minesweeper -->
        <div class="project-card Mobile">
          <div class="overflow-hidden bg-[#e8e4db]">
            <img src="/mine-sweeper.png" class="w-full h-64 object-cover project-img" alt="Minesweeper">
          </div>
          <div class="p-8">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-xl font-bold">Minesweeper</h3>
              <span
                class="text-xs font-bold uppercase tracking-widest text-[#1e836c] bg-[#e6f4f1] px-2 py-1 rounded">Mobile</span>
            </div>
            <p
              class="text-sm font-medium text-gray-500 mb-6 font-serif-elegant italic border-l-2 border-[#1e836c]/20 pl-4">
              iOS - Swift</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">A classic reimagined with modern customization and
              custom board logic.</p>
            <div class="pt-6 border-t border-gray-100 flex justify-between items-center">
              <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Feb 2017</span>
            </div>
          </div>
        </div>

        <!-- Lab Tracking System -->
        <div class="project-card Web">
          <div class="overflow-hidden bg-[#e8e4db]">
            <img src="/web.png" class="w-full h-64 object-cover project-img" alt="UCPRC Lab Tracking">
          </div>
          <div class="p-8">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-xl font-bold">Lab Tracking System</h3>
              <span
                class="text-xs font-bold uppercase tracking-widest text-blue-600 bg-blue-50 px-2 py-1 rounded">Web</span>
            </div>
            <p class="text-sm font-medium text-gray-500 mb-6 font-serif-elegant italic border-l-2 border-blue-200 pl-4">
              Node.js, MSSQL, Bootstrap</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">Robust system (UCPRC) that automates data collection
              for large-scale research labs.</p>
            <div class="pt-6 border-t border-gray-100 flex justify-between items-center">
              <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">2019 - 2021</span>
            </div>
          </div>
        </div>

        <!-- Civ Energy -->
        <div class="project-card Web">
          <div class="overflow-hidden bg-[#e8e4db]">
            <img src="/web1.png" class="w-full h-64 object-cover project-img" alt="Civ Energy">
          </div>
          <div class="p-8">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-xl font-bold">Civ Energy</h3>
              <span
                class="text-xs font-bold uppercase tracking-widest text-blue-600 bg-blue-50 px-2 py-1 rounded">Web</span>
            </div>
            <p class="text-sm font-medium text-gray-500 mb-6 font-serif-elegant italic border-l-2 border-blue-200 pl-4">
