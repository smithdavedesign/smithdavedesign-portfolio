        </div>

        <!-- Web Portfolio -->
        <div class="project-card Web">
          <div class="overflow-hidden bg-[#e8e4db]">
            <img src="/web3.png" class="w-full h-64 object-cover project-img" alt="Web Portfolio">
          </div>
          <div class="p-8">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-xl font-bold">Project Archive</h3>
              <span
                class="text-xs font-bold uppercase tracking-widest text-blue-600 bg-blue-50 px-2 py-1 rounded">Web</span>
            </div>
            <p class="text-sm font-medium text-gray-500 mb-6 font-serif-elegant italic border-l-2 border-blue-200 pl-4">
              PHP, Javascript</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">Legacy collection of about/bio elements and early web
              concepts.</p>
            <div class="pt-6 border-t border-gray-100 flex justify-between items-center">
              <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">2014 - 2021</span>
            </div>
          </div>
        </div>

        <!-- Recursive Maze -->
        <div class="project-card Desktop">
          <div class="overflow-hidden bg-[#e8e4db]">
            <img src="/desktop.png" class="w-full h-64 object-cover project-img" alt="Recursive Maze">
          </div>
          <div class="p-8">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-xl font-bold">Recursive Maze</h3>
              <span
                class="text-xs font-bold uppercase tracking-widest text-orange-600 bg-orange-50 px-2 py-1 rounded">Desktop</span>
            </div>
            <p
              class="text-sm font-medium text-gray-500 mb-6 font-serif-elegant italic border-l-2 border-orange-200 pl-4">
              C++ Systems</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">Randomly generated recursive mazes with solving
              algorithms.</p>
            <div class="pt-6 border-t border-gray-100 flex justify-between items-center">
              <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Oct 2012</span>
            </div>
          </div>
        </div>

        <!-- Real number calculator -->
        <div class="project-card Desktop">
          <div class="overflow-hidden bg-[#e8e4db]">
            <img src="/desktop2.jpg" class="w-full h-64 object-cover project-img" alt="Real Number Calculator">
          </div>
          <div class="p-8">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-xl font-bold">Precision Calculator</h3>
              <span
                class="text-xs font-bold uppercase tracking-widest text-orange-600 bg-orange-50 px-2 py-1 rounded">Desktop</span>
            </div>
            <p
              class="text-sm font-medium text-gray-500 mb-6 font-serif-elegant italic border-l-2 border-orange-200 pl-4">
              C++</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">High-precision arithmetic engine for complex
              real-number processing.</p>
            <div class="pt-6 border-t border-gray-100 flex justify-between items-center">
              <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">June 2014</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <style>
    .filter-btn {
      @apply px-8 py-3 rounded-full text-sm font-bold uppercase tracking-widest bg-white border border-gray-100 text-gray-400 transition-all flex items-center gap-2 hover:text-[#1e836c] hover:border-[#1e836c]/30;
    }

    .filter-btn.active {
      @apply bg-[#1e836c] text-white border-[#1e836c] shadow-[0_4px_15px_rgba(30, 131, 108, 0.2)];
    }

    .project-card {
      @apply bg-white rounded-3xl overflow-hidden shadow-sm border border-gray-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-500;
    }

    .project-img {
      @apply transition-transform duration-700 hover:scale-105 grayscale-[40%] hover:grayscale-0;
    }
  </style>

  <script>
    function filterSelection(c) {
      // Toggle Active Class
      $('.filter-btn').removeClass('active');
      $(event.target).closest('button').addClass('active');

      if (c == 'All') {
        $('.project-card').fadeIn(400);
      } else {
        $('.project-card').hide();
        $('.' + c).fadeIn(400);
      }
    }

    // Header interaction logic
    $(function () {
      var _top = $(window).scrollTop();
      var navB = document.getElementById("home-top");
      $(window).scroll(function () {
        var _cur_top = $(window).scrollTop();
        if (_top < _cur_top) {
          if (navB) navB.style.top = "-200px";
        } else {
          if (navB) {
            navB.style.top = "0";
            navB.style.backgroundColor = "rgba(255,255,255,0.95)";
            navB.style.backdropFilter = "blur(12px)";
          }
        }
        _top = _cur_top;
      });
    });
  </script>

  <%- contentFor('Footer') %>
    <%- include('../partials/Footer')%>