            <div class="pt-6 border-t border-gray-100 flex justify-between items-center">
              <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Jan 2015</span>
            </div>
          </div>
        </div>

        <!-- Meri Superak -->
        <div class="project-card Web">
          <div class="overflow-hidden bg-[#e8e4db]">
            <img src="/meri-superak.png" class="w-full h-64 object-cover project-img" alt="Meri Superak">
          </div>
          <div class="p-8">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-xl font-bold">Meri Superak</h3>
              <span
                class="text-xs font-bold uppercase tracking-widest text-blue-600 bg-blue-50 px-2 py-1 rounded">Web</span>
            </div>
            <p class="text-sm font-medium text-gray-500 mb-6 font-serif-elegant italic border-l-2 border-blue-200 pl-4">
              HTML5, JS, CSS4</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">Elegant artist portfolio landing page showcasing
              visual fine arts.</p>
            <div class="pt-6 border-t border-gray-100 flex justify-between items-center">
              <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">April 2018</span>
            </div>
